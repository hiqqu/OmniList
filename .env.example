# Optionale API-Schlüssel für OmniList Live-Suche & Account-Sync
# Nicht zwingend erforderlich – OmniList verfügt über vollwertige Mock-Fallback-Kataloge und öffentliche Schnittstellen.

TMDB_API_KEY=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Steam Web API Key (kostenlos unter https://steamcommunity.com/dev/apikey abrufbar)
STEAM_API_KEY=

# PlayStation Network (64-Zeichen NPSSO Cookie von https://ca.account.sony.com/api/v1/ssocookie)
PSN_NPSSO=

# GOG Galaxy (Benutzername oder Auth Token)
GOG_USERNAME=
GOG_TOKEN=
