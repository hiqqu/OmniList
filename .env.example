# Optionale API-Schlüssel für OmniList Live-Suche
# Nicht zwingend erforderlich – OmniList verfügt über vollwertige Mock-Fallback-Kataloge und öffentliche Schnittstellen.

TMDB_API_KEY=
RAWG_API_KEY=
GOOGLE_BOOKS_API_KEY=

# Cloud-Sync & Backup (Optional)
# Standardmäßig funktioniert der Sync-Code lokal im Netzwerk ohne Konfiguration.
# Für weltweiten Cloud-Sync über jedes Gerät trage hier entweder deine Upstash Redis
# oder Vercel KV REST-Zugangsdaten ein (kostenlos auf https://console.upstash.com):

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternativ für Vercel KV:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

